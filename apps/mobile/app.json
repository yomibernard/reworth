{
  "expo": {
    "name": "ReWorth",
    "slug": "reworth",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "reworth",
    "splash": {
      "backgroundColor": "#FAF9F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reworth.app",
      "associatedDomains": [
        "applinks:reworth.ng",
        "applinks:www.reworth.ng"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ReWorth needs photos to list and room-scan your items.",
        "NSCameraUsageDescription": "ReWorth needs the camera for room scan and listing photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F7"
      },
      "package": "com.reworth.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "reworth.ng",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.reworth.ng",
              "pathPrefix": "/"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReWorth to access your photos for listings and room scan.",
          "cameraPermission": "Allow ReWorth to use the camera for listing photos and room scan."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
