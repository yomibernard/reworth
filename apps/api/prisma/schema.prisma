  disputeRate            Float
  accountAgeDays         Int
  verificationPoints     Int
  computedAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([tier])
  @@map("trust_scores")
}

