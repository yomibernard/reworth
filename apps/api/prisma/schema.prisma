/// Two-way post-transaction review. Visible only when both sides have submitted (PUBLISHED).
model Review {
  id                     String       @id @default(uuid()) @db.Uuid
  orderId                String       @db.Uuid
  reviewerId             String       @db.Uuid
  revieweeId             String       @db.Uuid
  overall                Int
  accuracy               Int
  communication          Int
  punctuality            Int
  transactionExperience  Int
  body                   String?      @db.VarChar(500)
  photoKeys              String[]     @default([])
  status                 ReviewStatus @default(PENDING_MUTUAL)
  reply                  String?      @db.VarChar(200)
  repliedAt              DateTime?
  publishedAt            DateTime?
  createdAt              DateTime     @default(now())

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User          @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User          @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reports  ReviewReport[]

  @@unique([orderId, reviewerId])
  @@index([revieweeId, status])
  @@index([orderId])
  @@map("reviews")
}

