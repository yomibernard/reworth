// ReWorth API — Phase 1–3: Auth, Listings, Discovery

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationLevel {
  L1_PHONE
  L2_EMAIL
  L3_IDENTITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum IdentityMethod {
  NIN
  BVN
  GOV_ID
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  CUSTOMER_SUPPORT
  RISK_FRAUD
  FINANCE
  MARKETING
  CONTENT_MODERATOR
}

enum ListingStatus {
  DRAFT
  UNDER_REVIEW
  LIVE
  RESERVED
  SOLD
  EXPIRED
  REMOVED
  REJECTED
}

enum SellingMode {
  SELL
  SWAP
  SWAP_CASH
  GIVE_AWAY
}

enum ItemCondition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingEventType {
  VIEWED
  SAVED
  PRICE_CHANGED
  STATUS_CHANGED
}

enum ListingImageStatus {
  PENDING
  READY
  FAILED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String?    @unique
  phoneVerifiedAt DateTime?
  email           String?    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  profile       Profile?
  addresses     Address[]
  verifications Verification[]
  devices       Device[]
  refreshTokens RefreshToken[]
  roles         UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  listings      Listing[]
  listingEvents ListingEvent[] @relation("ListingEventActor")
  riskEvents    RiskEvent[]
  reports       Report[]       @relation("ReportReporter")
  favourites    Favourite[]
  savedSearches SavedSearch[]
  following     SellerFollow[] @relation("SellerFollowers")
  followers     SellerFollow[] @relation("SellerFollowing")

  @@map("users")
}

model Profile {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  displayName        String
  fullName           String?
  avatarUrl          String?
  bio                String?
  birthYear          Int?
  preferredCommunity String  @default("")
  language           String  @default("en-NG")
  currency           String  @default("NGN")
  showFullName       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  label     String
  line1     String
  line2     String?
  city      String
  community String
  country   String  @default("NG")
  geoLat    Float?
  geoLng    Float?
  isDefault Boolean @default(false)
  /// Always treat as private PII — never expose in public APIs.
  private   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Verification {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  level           VerificationLevel
  status          VerificationStatus @default(PENDING)
  method          IdentityMethod?
  providerRef     String?
  /// Hash only — never store raw NIN/BVN/gov ID.
  identifierHash  String?
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level])
  @@map("verifications")
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  name       String
  platform   DevicePlatform @default(UNKNOWN)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  role      AdminRole
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  parentId  String?  @db.Uuid
  sortOrder Int      @default(0)
  iconUrl   String?
  createdAt DateTime @default(now())

  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  listings     Listing[]  @relation("ListingCategory")
  subListings  Listing[]  @relation("ListingSubcategory")

  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

model Listing {
  id                  String        @id @default(uuid()) @db.Uuid
  sellerId            String        @db.Uuid
  title               String        @default("")
  description         String        @default("")
  categoryId          String?       @db.Uuid
  subcategoryId       String?       @db.Uuid
  brand               String?
  model               String?
  condition           ItemCondition @default(GOOD)
  ageText             String?
  originalPriceKobo   Int?
  priceKobo           Int           @default(0)
  negotiable          Boolean       @default(true)
  sellingMode         SellingMode   @default(SELL)
  status              ListingStatus @default(DRAFT)
  community           String        @default("")
  geoLat              Float?
  geoLng              Float?
  /// Private meetup / pickup address — NEVER expose in public DTOs.
  addressPrivate      String?
  fulfilmentPickup    Boolean       @default(true)
  fulfilmentMeet      Boolean       @default(true)
  fulfilmentDelivery  Boolean       @default(false)
  aiUsed              Boolean       @default(false)
  aiEditedFields      String[]      @default([])
  expiresAt           DateTime?
  publishedAt         DateTime?
  views               Int           @default(0)
  vehicle             Json?
  riskFlags           String[]      @default([])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  seller      User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category?      @relation("ListingCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Category?      @relation("ListingSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  images      ListingImage[]
  events      ListingEvent[]
  riskEvents  RiskEvent[]
  reports     Report[]
  favourites  Favourite[]

  @@index([sellerId])
  @@index([status])
  @@index([categoryId])
  @@index([community])
  @@index([publishedAt])
  @@index([expiresAt])
  @@map("listings")
}

model ListingImage {
  id            String             @id @default(uuid()) @db.Uuid
  listingId     String             @db.Uuid
  sortOrder     Int                @default(0)
  originalKey   String
  variants      Json               @default("{}")
  width         Int?
  height        Int?
  mime          String?
  sizeBytes     Int?
  dHash         String?
  exifStripped  Boolean            @default(false)
  status        ListingImageStatus @default(PENDING)
  createdAt     DateTime           @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@index([dHash])
  @@index([originalKey])
  @@map("listing_images")
}

model ListingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  listingId   String           @db.Uuid
  type        ListingEventType
  actorUserId String?          @db.Uuid
  payload     Json?
  createdAt   DateTime         @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ListingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([type])
  @@map("listing_events")
}

model RiskEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  listingId String?  @db.Uuid
  kind      String
  score     Int?
  detail    Json?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([userId])
  @@index([kind])
  @@map("risk_events")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  listingId  String       @db.Uuid
  reporterId String       @db.Uuid
  reason     String
  detail     String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model Favourite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("favourites")
}

model SellerFollow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @db.Uuid
  sellerId   String   @db.Uuid
  createdAt  DateTime @default(now())

  follower User @relation("SellerFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  seller   User @relation("SellerFollowing", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([followerId, sellerId])
  @@index([followerId])
  @@index([sellerId])
  @@map("seller_follows")
}

model SavedSearch {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  name            String
  filters         Json
  newMatchesCount Int       @default(0)
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}
