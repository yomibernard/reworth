# ReWorth local environment — copy to .env and fill placeholders.
# NEVER commit real secrets. All values below are examples / empty placeholders.

# --- App ---
NODE_ENV=development
APP_NAME=ReWorth
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# NGN / en-NG / Africa/Lagos (WAT)
DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en-NG
DEFAULT_TIMEZONE=Africa/Lagos

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://reworth:reworth@localhost:5432/reworth?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3-compatible media ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=reworth-media
S3_FORCE_PATH_STYLE=true
# Public/CDN base for object URLs (optional in local)
S3_PUBLIC_URL=http://localhost:9000/reworth-media

# --- OpenSearch ---
OPENSEARCH_NODE=http://localhost:9200
# Set true to prefer Postgres FTS even if OpenSearch is up
SEARCH_USE_POSTGRES_FTS_FALLBACK=false

# --- Auth / JWT ---
# Generate strong random values for local use; do not reuse in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Admin bootstrap ---
ADMIN_SUPER_EMAIL=admin@example.com
ADMIN_SUPER_PASSWORD=change-me-strong-password

# --- SMS (Termii preferred default; Twilio alternative) ---
SMS_PROVIDER=mock
# Termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (Mailhog locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@reworth.local

# --- Payments (Paystack) ---
PAYMENTS_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- AI ---
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/apple/callback

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# --- Feature flags / misc ---
ENABLE_PUSH=false
# FCM later
FCM_SERVER_KEY=
