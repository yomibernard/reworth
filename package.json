{
  "name": "reworth",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@reworth/api --filter=@reworth/web --filter=@reworth/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit:prod": "pnpm audit --prod --audit-level=critical",
    "seed:staging": "pnpm --filter @reworth/api seed:staging",
    "test:e2e": "playwright test"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "tar": "^7.5.19"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
